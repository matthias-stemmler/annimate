{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "1440 minutes"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["pnpm.catalog.default"],
      "matchUpdateTypes": [
        "bump",
        "digest",
        "lockFileMaintenance",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "rollback",
        "replacement"
      ],
      "groupName": "NPM dependencies non-major",
      "groupSlug": "npm-non-major"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["pnpm-workspace.overrides"],
      "enabled": false,
      "description": "Overrides are security floor pins that have done their job once they are at the fixed version, so there is no reason to keep them current"
    },
    {
      "matchPackageNames": ["graphannis", "graphannis-core"],
      "groupName": "graphANNIS monorepo",
      "groupSlug": "graphannis-monorepo"
    },
    {
      "matchPackageNames": ["tauri", "tauri-*", "@tauri-apps/**"],
      "groupName": "Tauri monorepo",
      "groupSlug": "tauri-monorepo"
    },
    {
      "matchPackageNames": ["toml", "toml_edit"],
      "groupName": "Toml monorepo",
      "groupSlug": "toml-monorepo"
    },
    {
      "extends": ["packages:vite"],
      "groupName": "Vite monorepo",
      "groupSlug": "vite-monorepo"
    },
    {
      "matchDatasources": ["github-runners"],
      "enabled": false,
      "description": "GitHub runners need to be pinned to make sure the required packages are available"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/.*\\.yml$/"],
      "matchStrings": [
        "\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s*versioning=(?<versioning>.*?)\\s*depName=(?<depName>.*?)\\s*\\n.*?:\\s*(?<currentValue>.*)\\s*"
      ]
    }
  ]
}
