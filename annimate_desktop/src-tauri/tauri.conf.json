{
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    },
    "windows": [
      {
        "dragDropEnabled": false,
        "fullscreen": false,
        "resizable": true,
        "title": "Annimate",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 640,
        "visible": false
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "Education",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/metainfo/io.github.matthias_stemmler.annimate.metainfo.xml": "bundle/linux/io.github.matthias_stemmler.annimate.metainfo.xml"
        }
      },
      "deb": {
        "desktopTemplate": "bundle/linux/Annimate.desktop",
        "files": {
          "/usr/share/metainfo/io.github.matthias_stemmler.annimate.metainfo.xml": "bundle/linux/io.github.matthias_stemmler.annimate.metainfo.xml"
        },
        "section": "science"
      }
    },
    "publisher": "Matthias Stemmler",
    "shortDescription": "Your Friendly ANNIS Match Exporter",
    "targets": ["app", "appimage", "deb", "nsis"],
    "windows": {
      "nsis": {
        "headerImage": "bundle/windows/nsis-header.bmp",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "uninstallerHeaderImage": "bundle/windows/nsis-header.bmp",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "identifier": "com.github.matthias-stemmler.annimate",
  "mainBinaryName": "Annimate",
  "plugins": {
    "opener": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "endpoints": [
        "https://github.com/matthias-stemmler/annimate/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBMDgxMjJFNzBERDk4QzkKUldUSm1OMXdMaElJcWlpUC9tR2VueW5iN3pHYlFRWWR3MEJ6OHFWblBIZU5adVczRXlXTEkvcmsK",
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "productName": "Annimate"
}
